{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Harness Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_code",
    "work_item_id",
    "work_item_level",
    "mode",
    "strict",
    "status",
    "stop_at",
    "current_stage",
    "created_at",
    "updated_at",
    "run_dir",
    "stages",
    "last_error"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "project_code": { "type": "string", "minLength": 1 },
    "work_item_id": { "type": "string", "minLength": 1 },
    "work_item_level": { "type": "string", "enum": ["S", "M", "L"] },
    "mode": {
      "type": "string",
      "enum": ["validate", "agent", "generation", "multi_role"]
    },
    "strict": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "paused",
        "waiting_approval",
        "failed",
        "completed",
        "cancelled"
      ]
    },
    "stop_at": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "current_stage": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "run_dir": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "last_error": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
