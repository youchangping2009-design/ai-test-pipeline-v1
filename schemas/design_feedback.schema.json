{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Design Feedback",
  "type": "object",
  "required": ["work_item_id", "feedback_items"],
  "properties": {
    "project_code": { "type": "string" },
    "work_item_id": { "type": "string" },
    "feedback_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feedback_id",
          "source_review_stage",
          "source_confirmation_file",
          "source_case_plan_ids",
          "feedback_type",
          "target_layer",
          "title",
          "finding",
          "recommended_action",
          "must_not_directly_overwrite_testcase",
          "status"
        ],
        "properties": {
          "feedback_id": { "type": "string", "pattern": "^DF-[0-9]{3,}$" },
          "source_review_stage": {
            "type": "string",
            "enum": ["frontend_code_review", "backend_code_review", "manual_review", "quality_gate"]
          },
          "source_confirmation_file": { "type": "string" },
          "source_case_plan_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CP-[0-9]{3,}$" }
          },
          "source_testcase_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "feedback_type": {
            "type": "string",
            "enum": ["case_gap", "implementation_gap", "invalid_case", "risk_note", "needs_confirmation", "no_action"]
          },
          "target_layer": {
            "type": "string",
            "enum": [
              "testability_gate",
              "acceptance_examples",
              "verification_responsibility_map",
              "test_design_matrix",
              "case_plan"
            ]
          },
          "title": { "type": "string" },
          "finding": { "type": "string" },
          "recommended_action": { "type": "string" },
          "must_not_directly_overwrite_testcase": { "type": "boolean", "const": true },
          "status": {
            "type": "string",
            "enum": ["open", "accepted", "rejected", "applied"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
