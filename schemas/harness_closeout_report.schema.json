{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Harness Closeout Report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_code",
    "work_item_id",
    "started_at",
    "completed_at",
    "passed",
    "formal_assets_unchanged",
    "before_hash",
    "after_hash",
    "commands"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "project_code": { "type": "string", "minLength": 1 },
    "work_item_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "formal_assets_unchanged": { "type": "boolean" },
    "before_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "after_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commands": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv",
          "exit_code",
          "duration_ms",
          "passed",
          "output_tail"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "passed": { "type": "boolean" },
          "output_tail": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
