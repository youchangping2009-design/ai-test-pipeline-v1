{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Harness Event",
  "type": "object",
  "required": ["schema_version", "sequence", "timestamp", "run_id", "event_type", "stage_id", "payload"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "run_created",
        "run_started",
        "run_resumed",
        "run_paused",
        "run_failed",
        "run_completed",
        "run_cancelled",
        "stage_started",
        "stage_skipped",
        "stage_succeeded",
        "stage_failed",
        "command_started",
        "command_completed",
        "stages_invalidated",
        "agent_turn_started",
        "agent_action_received",
        "agent_observation",
        "parallel_reviewer_started",
        "parallel_reviewer_action_received",
        "parallel_reviewer_completed",
        "parallel_review_barrier_passed",
        "parallel_review_barrier_failed",
        "parallel_review_bundle_created",
        "artifact_staged",
        "stage_validation_started",
        "stage_validation_completed",
        "stage_committed",
        "case_plan_commit_recovered",
        "multi_role_run_recovered",
        "approval_requested",
        "approval_resolved",
        "turn_budget_exhausted",
        "repair_budget_exhausted",
        "budget_exhausted",
        "telemetry_updated",
        "audit_completed",
        "hook_dispatch_started",
        "hook_dispatch_completed",
        "hook_dispatch_failed",
        "generation_started",
        "generation_bundle_received",
        "generation_candidate_validated",
        "generation_publish_started",
        "generation_publish_completed",
        "generation_publish_rolled_back"
      ]
    },
    "stage_id": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
