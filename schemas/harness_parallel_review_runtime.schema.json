{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Parallel Reviewer Runtime",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "stage_id",
    "reviewer_order",
    "input_fingerprint",
    "reviewers",
    "barrier",
    "bundle_hash",
    "status",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "const": "case_reviewer" },
    "reviewer_order": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "enum": ["evidence", "flow", "testcase"] }
    },
    "input_fingerprint": { "type": "string", "minLength": 64 },
    "reviewers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "reviewer",
          "status",
          "turns_used",
          "repair_rounds_used",
          "calls",
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "cost_usd",
          "finding_count",
          "action_count",
          "duration_ms",
          "error"
        ],
        "properties": {
          "reviewer": { "type": "string", "enum": ["evidence", "flow", "testcase"] },
          "status": { "type": "string", "enum": ["succeeded", "failed", "timed_out"] },
          "turns_used": { "type": "integer", "minimum": 0 },
          "repair_rounds_used": { "type": "integer", "minimum": 0 },
          "calls": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },
          "finding_count": { "type": "integer", "minimum": 0 },
          "action_count": { "type": "integer", "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "barrier": {
      "type": "object",
      "required": ["required", "succeeded", "passed"],
      "properties": {
        "required": { "type": "integer", "const": 3 },
        "succeeded": { "type": "integer", "minimum": 0, "maximum": 3 },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "bundle_hash": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["succeeded", "failed"] },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
