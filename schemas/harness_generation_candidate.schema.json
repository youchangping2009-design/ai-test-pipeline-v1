{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Controlled Generation Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_code",
    "work_item_id",
    "work_item_level",
    "provider",
    "created_at",
    "bundle_hash",
    "candidate_hash",
    "expected_target_hash",
    "expected_upstream_fingerprint",
    "files",
    "validation"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "project_code": { "type": "string", "minLength": 1 },
    "work_item_id": { "type": "string", "minLength": 1 },
    "work_item_level": { "type": "string", "enum": ["S", "M", "L"] },
    "provider": {
      "type": "string",
      "enum": ["existing", "command", "multi_role"]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "bundle_hash": { "type": "string", "pattern": "[a-f0-9]{64}" },
    "candidate_hash": { "type": "string", "pattern": "[a-f0-9]{64}" },
    "expected_target_hash": { "type": "string", "pattern": "[a-f0-9]{64}" },
    "expected_upstream_fingerprint": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "expected_target_hash"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "[a-f0-9]{64}" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "expected_target_hash": {
            "type": ["string", "null"],
            "pattern": "[a-f0-9]{64}"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "exit_code", "log_path"],
      "properties": {
        "passed": { "type": "boolean", "const": true },
        "exit_code": { "type": "integer", "const": 0 },
        "log_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
