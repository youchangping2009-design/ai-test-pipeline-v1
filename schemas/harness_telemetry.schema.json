{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Harness Telemetry",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "updated_at",
    "elapsed_ms",
    "model_calls",
    "model_duration_ms",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "cost_usd",
    "usage_reports",
    "usage_complete",
    "action_counts",
    "validation_attempts",
    "validation_failures",
    "diagnostic_count",
    "budget",
    "status",
    "stop_reason"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "model_calls": { "type": "integer", "minimum": 0 },
    "model_duration_ms": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "usage_reports": { "type": "integer", "minimum": 0 },
    "usage_complete": { "type": "boolean" },
    "models": { "type": "array", "items": { "type": "string" } },
    "providers": { "type": "array", "items": { "type": "string" } },
    "action_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "parallel_reviewers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "calls",
          "duration_ms",
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "cost_usd",
          "usage_reports",
          "action_counts",
          "finding_count",
          "status"
        ],
        "properties": {
          "calls": { "type": "integer", "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },
          "usage_reports": { "type": "integer", "minimum": 0 },
          "action_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
          "finding_count": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["running", "succeeded", "failed", "timed_out"] }
        },
        "additionalProperties": false
      }
    },
    "validation_attempts": { "type": "integer", "minimum": 0 },
    "validation_failures": { "type": "integer", "minimum": 0 },
    "diagnostic_count": { "type": "integer", "minimum": 0 },
    "budget": { "type": "object" },
    "status": { "type": "string", "minLength": 1 },
    "stop_reason": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
