{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Harness Diagnostic",
  "type": "object",
  "required": [
    "diagnostic_id",
    "code",
    "stage_id",
    "observed_stage_id",
    "artifact_path",
    "location",
    "severity",
    "message",
    "repair_hint",
    "retryable",
    "requires_human",
    "source_validator",
    "command_index",
    "exit_code"
  ],
  "properties": {
    "diagnostic_id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "stage_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "observed_stage_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "artifact_path": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "severity": { "type": "string", "enum": ["info", "warning", "error"] },
    "message": { "type": "string", "minLength": 1 },
    "repair_hint": { "type": ["string", "null"] },
    "retryable": { "type": "boolean" },
    "requires_human": { "type": "boolean" },
    "source_validator": { "type": "string", "minLength": 1 },
    "command_index": { "type": ["integer", "null"], "minimum": 1 },
    "exit_code": { "type": "integer" }
  },
  "additionalProperties": false
}
