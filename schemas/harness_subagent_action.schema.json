{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Test Pipeline Parallel Reviewer Action",
  "type": "object",
  "required": ["action_id", "action_type", "reviewer", "arguments", "expected_outcome"],
  "properties": {
    "action_id": { "type": "string", "minLength": 1 },
    "action_type": {
      "type": "string",
      "enum": ["read_artifact", "submit_findings", "finish_review"]
    },
    "reviewer": {
      "type": "string",
      "enum": ["evidence", "flow", "testcase"]
    },
    "arguments": { "type": "object" },
    "expected_outcome": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
