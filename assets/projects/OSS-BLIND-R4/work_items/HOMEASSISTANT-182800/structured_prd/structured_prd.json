  "requirement_info": {
    "requirement_title": "避免缓存 TTS 音频产生重复 ID3 标签",
    "requirement_background": "部分 TTS provider 返回的 MP3 已包含 ID3/TSSE 元数据，再次写标签会形成两个 ID3 头；内存缓存清理后，严格解码器可能将磁盘文件播放为静音。",
    "requirement_goal": "对已带 ID3 的 MP3 写入 Home Assistant 标签时维持单一标签结构、保留元数据和音频内容，并保证磁盘缓存回放可用。",
    "explicit_rules": [
      {
        "rule_id": "HA-R001",
        "rule_text": "已带 ID3 标签的 MP3 写入 Home Assistant 标签后只能保留一个有效 ID3 头。",
        "rule_type": "data_rule",
        "priority": "high",
        "applies_to": "ID3 标签合并",
        "source_scope": "primary_requirement"
      },
      {
        "rule_id": "HA-R002",
        "rule_text": "更新标签时必须保留输入中的 TSSE 元数据。",
        "rule_type": "data_rule",
        "priority": "high",
        "applies_to": "ID3 标签合并",
        "source_scope": "primary_requirement"
      },
      {
        "rule_id": "HA-R003",
        "rule_text": "标签处理不得改变 MP3 音频帧内容。",
        "rule_type": "data_rule",
        "priority": "high",
        "applies_to": "ID3 标签合并",
        "source_scope": "primary_requirement"
      },
      {
        "rule_id": "HA-R004",
        "rule_text": "缓存文件从内存路径切换为磁盘读取后仍应可被严格解码器正常播放，不能静音。",
        "rule_type": "state_constraint",
        "priority": "high",
        "applies_to": "缓存音频回放",
        "source_scope": "primary_requirement"
      },
      {
        "rule_id": "HA-R005",
        "rule_text": "未带 ID3 标签的 MP3 仍可添加所需标签并保持可播放。",
        "rule_type": "fallback_constraint",
        "priority": "medium",
        "applies_to": "ID3 标签合并",
        "source_scope": "primary_requirement"
      },
      {
        "rule_id": "HA-R006",
        "rule_text": "已带标签音频的处理结果不应依赖具体 TTS provider。",
        "rule_type": "coverage_constraint",
        "priority": "high",
        "applies_to": "ID3 标签合并",
        "source_scope": "primary_requirement"
      }
    ],
