              "field_name": "display_day_x",
              "display_name": "X",
              "data_type": "integer",
              "required": true,
              "editable": true,
              "format_rule": "[1,99]之间的正整数",
              "terminal": "ADMIN"
            },
            {
              "field_name": "touch_user_type",
              "display_name": "触达用户类型",
              "data_type": "enum",
              "required": true,
              "editable": false,
              "enum_values": [
                "游戏付费用户",
                "当日未进入游戏",
                "全部用户"
              ],
              "terminal": "ADMIN"
            },
            {
              "field_name": "jump_type",
              "display_name": "跳转类型",
              "data_type": "enum",
              "required": true,
              "editable": true,
              "enum_values": [
                "无交互",
                "活动中心",
                "链接"
              ],
              "terminal": "ADMIN"
            },
            {
              "field_name": "selected_activity",
              "display_name": "选择活动",
              "data_type": "enum",
              "required": true,
              "editable": true,
              "data_source": "活动中心渠道=小程序活动，状态=发布，按活动创建时间倒序",
              "terminal": "ADMIN"
            },
            {
              "field_name": "link_url",
              "display_name": "链接",
              "data_type": "string",
              "required": true,
              "editable": true,
              "length_rule": "varchar(1000)",
              "terminal": "ADMIN"
            },
            {
              "field_name": "show_tab",
              "display_name": "展示tab",
              "data_type": "array",
              "required": true,
              "editable": true,
              "data_source": "小程序导航名称列表",
              "terminal": "ADMIN"
            },
            {
              "field_name": "status",
              "display_name": "状态",
              "data_type": "enum",
              "required": true,
              "editable": true,
              "default_value": "关闭",
              "enum_values": [
                "关闭",
                "开启"
              ],
              "terminal": "ADMIN"
            }
          ],
          "field_rules": [
            {
              "rule_id": "FR-BANNER-001",
              "field_name": "display_type",
              "display_name": "展示类型",
              "rule_text": "展示类型默认为空，不可编辑",
              "rule_type": "effect_constraint",
              "must_cover": true
