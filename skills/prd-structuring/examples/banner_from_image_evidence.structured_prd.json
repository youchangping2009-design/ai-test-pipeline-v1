            "展示类型必选",
            "X必填且范围为1到99",
            "触达用户类型必选",
            "跳转类型支持无交互、活动中心、链接",
            "跳转类型=活动中心时选择活动必填",
            "跳转类型=链接时链接必填",
            "展示tab必选",
            "状态默认关闭且状态选项为关闭、开启"
          ],
          "field_definitions": [
            {
              "field_name": "banner_name",
              "display_name": "banner名称",
              "data_type": "string",
              "required": true,
              "editable": true,
              "length_rule": "varchar(10)",
              "terminal": "ADMIN"
            },
            {
              "field_name": "banner_image",
              "display_name": "banner图片",
              "data_type": "image",
              "required": true,
              "editable": true,
              "terminal": "ADMIN"
