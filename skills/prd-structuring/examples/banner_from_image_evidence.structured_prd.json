            {
              "rule_id": "FR-BANNER-002",
              "field_name": "selected_activity",
              "display_name": "选择活动",
              "rule_text": "跳转类型=活动中心时选择活动必填，数据来源于状态为发布的小程序活动",
              "rule_type": "data_source_constraint",
              "must_cover": true
            }
          ],
